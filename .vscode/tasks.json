{
  // DXL2-C tasks. Task menu: Ctrl+Shift+B (no default build task, so VS Code
  // shows the list) or Terminal > Run Task...
  // Python tasks use the project virtual environment in .venv; run
  // "Python: Setup venv" once before the GUI, test and documentation tasks.
  // Works on Windows, Linux and macOS ("windows" blocks override the defaults).
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    // ======================================================================
    // Python virtual environment
    // ======================================================================
    {
      "label": "Python: Create venv",
      "hide": true,
      "detail": "Create the .venv virtual environment",
      "type": "process",
      "command": "python3",
      "args": ["-m", "venv", ".venv"],
      "windows": {
        "command": "py",
        "args": ["-3", "-m", "venv", ".venv"]
      },
      "problemMatcher": []
    },
    {
      "label": "Python: Install requirements",
      "hide": true,
      "detail": "pip install -r requirements-dev.txt (GUI, pytest, MkDocs)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": ["-m", "pip", "install", "--upgrade", "-r", "requirements-dev.txt"],
      "problemMatcher": []
    },
    {
      "label": "Python: Setup venv",
      "group": "build",
      "detail": "Create .venv and install all development requirements",
      "dependsOrder": "sequence",
      "dependsOn": ["Python: Create venv", "Python: Install requirements"],
      "problemMatcher": []
    },
    {
      "label": "Python: Delete venv",
      "group": "build",
      "detail": "Remove the .venv folder",
      "type": "process",
      "command": "cmake",
      "args": ["-E", "rm", "-rf", ".venv"],
      "problemMatcher": []
    },

    // ======================================================================
    // DXL2 Studio GUI (tools/dxl2_gui)
    // ======================================================================
    {
      "label": "GUI: Configure native bridge",
      "hide": true,
      "detail": "CMake configure of tools/dxl2_gui/native (static libdxl2 -> dxl2_gui_native)",
      "type": "process",
      "command": "cmake",
      "args": [
        "-G", "Unix Makefiles",
        "-S", "tools/dxl2_gui/native",
        "-B", "tools/dxl2_gui/build",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "problemMatcher": []
    },
    {
      "label": "GUI: Build native bridge",
      "group": "build",
      "detail": "Build the static DXL2 library and the shared bridge loaded by the GUI",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "tools/dxl2_gui/build", "--config", "Release"],
      "dependsOn": ["GUI: Configure native bridge"],
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": "absolute"
      }
    },
    {
      "label": "GUI: Run (Simulation)",
      "group": "build",
      "detail": "Start DXL2 Studio connected to the simulated device (static library)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": [
        "tools/dxl2_gui/dxl2_gui.py",
        "--mode", "sim",
        "--id", "${input:simId}",
        "--connect"
      ],
      "dependsOn": ["GUI: Build native bridge"],
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "GUI: Run (Serial port)",
      "group": "build",
      "detail": "Start DXL2 Studio connected to an embedded device over a serial port",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "tools/dxl2_gui/dxl2_gui.py",
        "--mode", "serial",
        "--port", "${input:serialPortPosix}",
        "--baud", "${input:baudRate}",
        "--connect"
      ],
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
        "args": [
          "tools/dxl2_gui/dxl2_gui.py",
          "--mode", "serial",
          "--port", "${input:serialPortWindows}",
          "--baud", "${input:baudRate}",
          "--connect"
        ]
      },
      "dependsOn": ["GUI: Build native bridge"],
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "GUI: Run (choose in app)",
      "group": "build",
      "detail": "Start DXL2 Studio without connecting; pick the mode in the window",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": ["tools/dxl2_gui/dxl2_gui.py"],
      "dependsOn": ["GUI: Build native bridge"],
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "GUI: List serial ports",
      "group": "build",
      "detail": "Print the serial ports pyserial can see",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": ["-m", "serial.tools.list_ports", "-v"],
      "problemMatcher": []
    },
    {
      "label": "GUI: Clean native bridge",
      "group": "build",
      "detail": "Remove tools/dxl2_gui/build",
      "type": "process",
      "command": "cmake",
      "args": ["-E", "rm", "-rf", "tools/dxl2_gui/build"],
      "problemMatcher": []
    },

    // ======================================================================
    // Library build (CMakePresets.json)
    // ======================================================================
    {
      "label": "Library: Configure (Debug)",
      "hide": true,
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "DXL2[Debug]"],
      "problemMatcher": []
    },
    {
      "label": "Library: Build (Debug)",
      "group": "build",
      "detail": "Static library with debug information",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build/DXL2[Debug]"],
      "dependsOn": ["Library: Configure (Debug)"],
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": "absolute"
      }
    },
    {
      "label": "Library: Configure (Release)",
      "hide": true,
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "DXL2[Release]"],
      "problemMatcher": []
    },
    {
      "label": "Library: Build (Release)",
      "group": "build",
      "detail": "Optimized static library (libdxl2.a)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build/DXL2[Release]"],
      "dependsOn": ["Library: Configure (Release)"],
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": "absolute"
      }
    },
    {
      "label": "Library: Clean all builds",
      "group": "build",
      "detail": "Remove the build folder of every preset",
      "type": "process",
      "command": "cmake",
      "args": ["-E", "rm", "-rf", "build"],
      "problemMatcher": []
    },

    // ======================================================================
    // Tests
    // ======================================================================
    {
      "label": "Tests: Configure unit tests",
      "hide": true,
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "DXL2[UnitTests]"],
      "problemMatcher": []
    },
    {
      "label": "Tests: Build unit tests",
      "hide": true,
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build/DXL2[UnitTests]"],
      "dependsOn": ["Tests: Configure unit tests"],
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": "absolute"
      }
    },
    {
      "label": "Tests: Run unit tests",
      "group": "build",
      "detail": "GoogleTest suite through CTest",
      "type": "process",
      "command": "ctest",
      "args": ["--test-dir", "build/DXL2[UnitTests]", "-L", "unit", "--output-on-failure"],
      "dependsOn": ["Tests: Build unit tests"],
      "problemMatcher": []
    },
    {
      "label": "Tests: Coverage report",
      "group": "build",
      "detail": "Unit tests + gcovr report (target 'coverage')",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build/DXL2[UnitTests]", "--target", "coverage"],
      "dependsOn": ["Tests: Configure unit tests"],
      "problemMatcher": []
    },
    {
      "label": "Tests: Run integration tests",
      "group": "build",
      "detail": "pytest suite (Python codec and C/Python cross-check), uses .venv",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": ["-m", "pytest", "tests/integration", "-v", "-p", "no:cacheprovider"],
      "problemMatcher": []
    },

    // ======================================================================
    // Static analysis (targets exist when the tools are installed)
    // ======================================================================
    {
      "label": "Analysis: Cppcheck",
      "group": "build",
      "detail": "Target 'cppcheck-analyze' (report in build/DXL2[Debug]/cppcheck.txt)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build/DXL2[Debug]", "--target", "cppcheck-analyze"],
      "dependsOn": ["Library: Configure (Debug)"],
      "problemMatcher": {
        "base": "$gcc",
        "fileLocation": "absolute"
      }
    },
    {
      "label": "Analysis: MISRA C:2012",
      "group": "build",
      "detail": "Target 'misra-analyze' (report in build/DXL2[Debug]/misra.txt)",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "build/DXL2[Debug]", "--target", "misra-analyze"],
      "dependsOn": ["Library: Configure (Debug)"],
      "problemMatcher": []
    },

    // ======================================================================
    // Documentation (MkDocs + mkdoxy, needs Doxygen in PATH)
    // ======================================================================
    {
      "label": "Docs: Serve on localhost",
      "group": "build",
      "detail": "mkdocs serve on http://127.0.0.1:8000 with live reload; opens the browser",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": ["-m", "mkdocs", "serve", "--dev-addr", "127.0.0.1:${input:docsPort}", "--open"],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "mkdocs",
        "pattern": { "regexp": "^(ERROR|WARNING)\\s+-\\s+(.*)$", "severity": 1, "message": 2 },
        "background": {
          "activesBegin": true,
          "beginsPattern": "Building documentation",
          "endsPattern": "Serving on"
        }
      }
    },
    {
      "label": "Docs: Build site",
      "group": "build",
      "detail": "mkdocs build into site/",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "args": ["-m", "mkdocs", "build", "--clean"],
      "problemMatcher": []
    }
  ],

  "inputs": [
    {
      "id": "simId",
      "type": "promptString",
      "description": "Simulated device ID (0-252)",
      "default": "1"
    },
    {
      "id": "serialPortWindows",
      "type": "promptString",
      "description": "Serial port (COM3) or pyserial URL (socket://host:port); empty = first detected port",
      "default": "COM3"
    },
    {
      "id": "serialPortPosix",
      "type": "promptString",
      "description": "Serial port (/dev/ttyUSB0, /dev/ttyACM0) or pyserial URL; empty = first detected port",
      "default": "/dev/ttyUSB0"
    },
    {
      "id": "baudRate",
      "type": "pickString",
      "description": "Baud rate",
      "options": ["9600", "57600", "115200", "1000000", "2000000", "3000000", "4000000", "4500000"],
      "default": "57600"
    },
    {
      "id": "docsPort",
      "type": "promptString",
      "description": "Local documentation port",
      "default": "8000"
    }
  ]
}
