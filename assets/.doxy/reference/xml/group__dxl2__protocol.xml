        <type>int</type>
        <definition>int dxl2_encode</definition>
        <argsstring>(uint8_t id, uint8_t instruction, const uint8_t *parameters, uint16_t parameter_length, uint8_t *output, size_t output_capacity, size_t *output_length)</argsstring>
        <name>dxl2_encode</name>
        <param>
          <type>uint8_t</type>
          <declname>id</declname>
        </param>
        <param>
          <type>uint8_t</type>
          <declname>instruction</declname>
        </param>
        <param>
          <type>const uint8_t *</type>
          <declname>parameters</declname>
        </param>
        <param>
          <type>uint16_t</type>
          <declname>parameter_length</declname>
        </param>
        <param>
          <type>uint8_t *</type>
          <declname>output</declname>
        </param>
        <param>
          <type>size_t</type>
          <declname>output_capacity</declname>
        </param>
        <param>
          <type>size_t *</type>
          <declname>output_length</declname>
        </param>
        <briefdescription>
<para>Encode a Protocol 2.0 packet, adding byte stuffing and CRC. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>id</parametername>
</parameternamelist>
<parameterdescription>
<para>Packet ID. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>instruction</parametername>
</parameternamelist>
<parameterdescription>
<para>Instruction byte. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>parameters</parametername>
</parameternamelist>
<parameterdescription>
<para>Unstuffed parameter bytes, or NULL when the length is zero. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>parameter_length</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of parameter bytes. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>output</parametername>
</parameternamelist>
<parameterdescription>
<para>Destination buffer for the complete wire packet. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>output_capacity</parametername>
</parameternamelist>
<parameterdescription>
<para>Capacity of <computeroutput>output</computeroutput> in bytes. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>output_length</parametername>
</parameternamelist>
<parameterdescription>
<para>Receives the encoded packet length on success. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<parameterlist kind="retval"><parameteritem>
<parameternamelist>
<parametername>0</parametername>
</parameternamelist>
<parameterdescription>
<para>Packet encoded successfully. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>DXL2_PARSE_ERROR</parametername>
</parameternamelist>
<parameterdescription>
<para>Invalid input or insufficient output capacity. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
