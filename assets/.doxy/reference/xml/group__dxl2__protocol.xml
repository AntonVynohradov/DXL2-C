    <sectiondef kind="user-defined">
      <header>CRC and packet parsing</header>
      <memberdef kind="function" id="group__dxl2__protocol_1gaa4decaae4fb141106641431bcc78ecd3" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>uint16_t</type>
        <definition>uint16_t dxl2_crc16</definition>
        <argsstring>(const uint8_t *data, size_t length)</argsstring>
        <name>dxl2_crc16</name>
        <param>
          <type>const uint8_t *</type>
          <declname>data</declname>
        </param>
        <param>
          <type>size_t</type>
          <declname>length</declname>
        </param>
        <briefdescription>
<para>Calculate the Protocol 2.0 CRC-16 checksum. </para>
        </briefdescription>
        <detaileddescription>
<para>Uses polynomial 0x8005 and an initial CRC value of zero.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>data</parametername>
</parameternamelist>
<parameterdescription>
<para>Bytes covered by the CRC. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>length</parametername>
</parameternamelist>
<parameterdescription>
<para>Number of bytes to process. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Calculated 16-bit CRC; 0 (the initial value) when <computeroutput>data</computeroutput> is NULL. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
